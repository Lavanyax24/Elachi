# Copy this file to .env for local development.
# On Render, set these as Environment Variables in the dashboard instead —
# never commit a real .env file.

DATABASE_URL=postgresql://user:password@localhost:5432/elachi

# Firebase Admin SDK service account (Project Settings > Service Accounts >
# Generate new private key). Paste the ENTIRE JSON contents as a single-line
# string here — see src/middleware/auth.js.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Cohere API key (https://dashboard.cohere.com/api-keys) — free Trial key,
# no credit card required, 1,000 calls/month.
COHERE_API_KEY=

PORT=3000